# ---------------------------------------------------------------- required --
# Absolute public URL. QR codes and every emailed link are built from it, so a
# wrong value here prints unusable work orders.
APP_URL=https://tracker.questwatersports.example

# Password for the service writer portal. Mechanics never use it.
ADMIN_PASSWORD=change-me

# HMAC key for session cookies. Any long random string; changing it signs
# everyone out. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me

# ---------------------------------------------------------------- storage --
# SQLite database and every upload live here. Must be a persistent volume,
# and must be included in whatever backs the server up.
DATA_DIR=/var/lib/quest-tracker

# ------------------------------------------------------------------- mail --
# Gmail SMTP to start with; swap the host/port for a custom mail server later.
# With a free Gmail account SMTP_PASS must be an App Password, not the account
# password. Leave blank and mail is skipped and logged rather than failing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=questwsottawa@gmail.com
SMTP_PASS=
MAIL_FROM=questwsottawa@gmail.com

# Where the "new log entry" notifications go — the service writer's inbox.
SERVICE_WRITER_EMAIL=

# ----------------------------------------------------------------- speech --
# AssemblyAI transcribes mechanics' voice notes. Without it the audio is still
# recorded and kept; only the typed-up text is missing.
ASSEMBLYAI_API_KEY=

# ------------------------------------------------------------------ shop ---
SHOP_NAME=Quest Watersports
SHOP_PHONE=(815) 555-0100

# How long a mechanic's PIN unlock lasts on their phone before it is asked for
# again. Ten hours covers a shift.
MECHANIC_SESSION_HOURS=10
